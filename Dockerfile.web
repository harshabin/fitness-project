# --- Stage 1: Build ---
FROM node:20-alpine AS builder

WORKDIR /app

# Copy root configurations and lockfile
COPY package.json package-lock.json turbo.json tsconfig.base.json ./

# Copy packages and Web app
COPY packages/ ./packages/
COPY apps/web/ ./apps/web/

# Install dependencies and build shared packages + Web
RUN npm ci --legacy-peer-deps
RUN npm run build --filter=@fithealth/types --filter=@fithealth/three-scenes --filter=@fithealth/web

# --- Stage 2: Production Runner ---
FROM node:20-alpine AS runner

WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000

COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/apps/web ./apps/web

EXPOSE 3000

CMD ["npm", "--prefix", "apps/web", "run", "start"]
