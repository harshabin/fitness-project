# ===================================================
# FitHealth Monorepo - Global Environment Variables
# ===================================================

# Node Environment (development | production | test)
NODE_ENV=development

# Web Frontend Port
WEB_PORT=3000

# API Gateway Port
API_PORT=4000

# Public API URL used by Web frontend to connect to backend
NEXT_PUBLIC_API_URL=http://localhost:4000

# Authentication & Security (JWT Secret for tokens)
JWT_SECRET=fithealth_super_secret_jwt_key_2026_change_in_prod
JWT_EXPIRATION=7d
